<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantallas de sesión. MainActivity cambia el inicio según AppViewModel (sesión y rol).
  Toda navegación entre login, cambio de contraseña e inicio limpia la pila (ver Navegacion.kt);
  solo el registro se apila sobre el login.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="co.ecocomunidad.app.ui.login.LoginFragment">
        <!-- Por qué se volvió al login (sesión cerrada, cuenta bloqueada, administrador) -->
        <argument
            android:name="motivo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- Al volver de un registro exitoso: correo ya escrito y aviso de cuenta creada -->
        <argument
            android:name="correo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="cuentaCreada"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="co.ecocomunidad.app.ui.registro.RegistroFragment" />

    <!-- Obligatoria (RN-05) es la única de la pila; desde "Mi cuenta" se apila y al guardar vuelve -->
    <fragment
        android:id="@+id/cambiarContrasenaFragment"
        android:name="co.ecocomunidad.app.ui.contrasena.CambiarContrasenaFragment">
        <argument
            android:name="desdeMiCuenta"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/inicioCiudadanoFragment"
        android:name="co.ecocomunidad.app.ui.inicio.InicioCiudadanoFragment" />

    <!-- Inicio del gestor: Mis tareas -->
    <fragment
        android:id="@+id/inicioGestorFragment"
        android:name="co.ecocomunidad.app.ui.tareas.MisTareasFragment" />

    <!-- Se apila sobre Mis tareas. No hay GET tareas/{id}/: se arma con mias, acciones y el reporte -->
    <fragment
        android:id="@+id/detalleTareaFragment"
        android:name="co.ecocomunidad.app.ui.tareas.DetalleTareaFragment">
        <argument
            android:name="idTarea"
            app:argType="integer" />
    </fragment>

    <!-- Se apilan sobre la lista: atrás vuelve a ella -->
    <fragment
        android:id="@+id/detalleReporteFragment"
        android:name="co.ecocomunidad.app.ui.reportes.DetalleReporteFragment">
        <argument
            android:name="idReporte"
            app:argType="integer" />
    </fragment>

    <!-- Al crear bien, vuelve a la lista y le avisa por su SavedStateHandle (ver RESULTADO_REPORTE_CREADO) -->
    <fragment
        android:id="@+id/crearReporteFragment"
        android:name="co.ecocomunidad.app.ui.reportes.crear.CrearReporteFragment" />

    <!-- El mismo formulario, cargado con el reporte (RN-07). Al guardar vuelve al detalle -->
    <fragment
        android:id="@+id/editarReporteFragment"
        android:name="co.ecocomunidad.app.ui.reportes.crear.CrearReporteFragment">
        <argument
            android:name="idReporte"
            app:argType="integer" />
    </fragment>

    <!-- Novedad sobre un reporte propio (RN-18). Al enviar bien, se reemplaza por "Mis novedades" -->
    <fragment
        android:id="@+id/reportarNovedadFragment"
        android:name="co.ecocomunidad.app.ui.novedades.ReportarNovedadFragment">
        <argument
            android:name="idReporte"
            app:argType="integer" />
    </fragment>

    <!-- Se abre al enviar una novedad, desde "Mi cuenta" y desde una notificación novedad_respondida -->
    <fragment
        android:id="@+id/misNovedadesFragment"
        android:name="co.ecocomunidad.app.ui.novedades.MisNovedadesFragment">
        <!-- true al llegar desde el formulario: se muestra que la novedad quedó enviada -->
        <argument
            android:name="novedadEnviada"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <!-- Se apila sobre el detalle de la tarea; al guardar vuelve a él (ver RESULTADO_ACCION_REGISTRADA) -->
    <fragment
        android:id="@+id/registrarAccionFragment"
        android:name="co.ecocomunidad.app.ui.tareas.RegistrarAccionFragment">
        <argument
            android:name="idTarea"
            app:argType="integer" />
    </fragment>

    <!-- Campana del inicio. Tocar una notificación abre Mis novedades, Mis sanciones o el reporte -->
    <fragment
        android:id="@+id/notificacionesFragment"
        android:name="co.ecocomunidad.app.ui.notificaciones.NotificacionesFragment" />

    <!-- Desde "Mi cuenta" y desde una notificación de sanción -->
    <fragment
        android:id="@+id/misSancionesFragment"
        android:name="co.ecocomunidad.app.ui.sanciones.MisSancionesFragment" />

    <!-- Menú del inicio del ciudadano -->
    <fragment
        android:id="@+id/miCuentaFragment"
        android:name="co.ecocomunidad.app.ui.cuenta.MiCuentaFragment" />

    <fragment
        android:id="@+id/fotoFragment"
        android:name="co.ecocomunidad.app.ui.reportes.FotoFragment">
        <argument
            android:name="url"
            app:argType="string" />
    </fragment>
</navigation>
