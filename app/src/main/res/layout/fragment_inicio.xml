<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio temporal de ciudadano y gestor: saludo de Brotico y cierre de sesión. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="560dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    layout="@layout/vista_logo_con_nombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_cerrar_sesion"
                    style="@style/Widget.EcoComunidad.BotonTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cerrar_sesion"
                    app:icon="@drawable/ic_salir"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Tarjeta destacada en verde bosque (marca.md) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EcoComunidad.TarjetaDestacada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:contentDescription="@string/brotico_saludando"
                        android:src="@drawable/brotico_saluda" />

                    <TextView
                        android:id="@+id/saludo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/saludo_sin_nombre"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Titulo"
                        android:textColor="@color/superficie" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/saludo_barrio"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                        android:textColor="@color/verde_brote" />

                    <TextView
                        android:id="@+id/rol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/fondo_pildora_rol"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Etiqueta"
                        android:textColor="@color/verde_bosque"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
