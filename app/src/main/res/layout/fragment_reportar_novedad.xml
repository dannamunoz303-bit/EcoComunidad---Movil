<?xml version="1.0" encoding="utf-8"?>
<!--
  Novedad (RN-18). Ciudadano: queja o incidente sobre un reporte propio asignado, en proceso o resuelto;
  el gestor es opcional (tarea_id). Gestor: ayuda o incidente sobre su tarea activa, sin desplegable.
  La descripción es obligatoria. Los textos que cambian según el modo se ponen en ReportarNovedadFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra: volver y título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/volver"
            app:icon="@drawable/ic_volver"
            app:iconTint="@color/verde_bosque" />

        <TextView
            android:id="@+id/titulo_pantalla"
            style="@style/Widget.EcoComunidad.TextoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:accessibilityHeading="true"
            android:text="@string/reportar_novedad"
            android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Mientras se abre el reporte o si no se pudo abrir -->
        <include
            android:id="@+id/estado_carga"
            layout="@layout/vista_estado_carga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="20dp"
            tools:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="560dp">

                    <!-- El reporte (ciudadano) o la tarea (gestor) sobre el que se escribe -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EcoComunidad.TarjetaClara"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/etiqueta_tarjeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/novedad_sobre_reporte"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Etiqueta"
                                android:textColor="@color/verde_musgo" />

                            <TextView
                                android:id="@+id/titulo_reporte"
                                style="@style/Widget.EcoComunidad.TextoTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta"
                                android:textColor="@color/tinta"
                                tools:text="Mancha de aceite en la quebrada" />

                            <TextView
                                android:id="@+id/estado_reporte"
                                style="@style/Widget.EcoComunidad.EtiquetaEstado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                tools:text="@string/estado_en_proceso" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tipo: dos opciones grandes. Ayuda solo para el gestor; queja solo para el ciudadano -->
                    <TextView
                        style="@style/Widget.EcoComunidad.TextoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:accessibilityHeading="true"
                        android:text="@string/novedad_que_paso"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Subtitulo"
                        android:textSize="18sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/opcion_ayuda"
                        style="@style/Widget.EcoComunidad.OpcionNovedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="16dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opcion_ayuda"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/opcion_ayuda_explicacion"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textColor="@color/tinta_suave"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/opcion_queja"
                        style="@style/Widget.EcoComunidad.OpcionNovedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        tools:checked="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="16dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tipo_queja"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/tipo_queja_ayuda"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textColor="@color/tinta_suave"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/opcion_incidente"
                        style="@style/Widget.EcoComunidad.OpcionNovedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="16dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tipo_incidente"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/explicacion_incidente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/tipo_incidente_ayuda"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textColor="@color/tinta_suave"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/error_tipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                        android:textColor="@color/arcilla"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Gestor (opcional, solo el ciudadano) y descripción -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campo_gestor"
                        style="@style/Widget.EcoComunidad.Campo.Desplegable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/campo_gestor">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/texto_gestor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:text="Carlos Pérez" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campo_descripcion"
                        style="@style/Widget.EcoComunidad.Campo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/campo_descripcion_novedad">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4"
                            tools:text="La mancha volvió a aparecer en la orilla después de la limpieza." />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/aviso_respuesta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/novedad_aviso_respuesta"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                        android:textColor="@color/tinta_suave"
                        android:textSize="14sp"
                        app:lineHeight="20sp" />

                    <!-- Lo que el backend rechazó y no es de un campo -->
                    <include
                        android:id="@+id/aviso"
                        layout="@layout/vista_aviso"
                        tools:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_enviar"
                            style="@style/Widget.EcoComunidad.BotonPrincipal"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/boton_enviar_novedad" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cargando"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/tinta_suave"
                            app:indicatorSize="18dp"
                            app:trackThickness="2dp" />
                    </FrameLayout>

                    <!-- Envío de más de 1 s: el texto junto al indicador de progreso -->
                    <LinearLayout
                        android:id="@+id/carga_larga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/novedad_enviando"
                            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                            android:textColor="@color/tinta_suave"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
