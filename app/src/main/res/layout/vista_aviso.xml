<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso sobrio para errores y motivos de cierre (sin Brotico). Oculto hasta que haya texto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aviso"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/fondo_aviso"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_alerta"
        app:tint="@color/arcilla" />

    <TextView
        android:id="@+id/aviso_texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
        android:textSize="14sp"
        app:lineHeight="20sp" />
</LinearLayout>
