<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla principal del ciudadano. El encabezado (barra, saludo y pestañas), los estados
  de carga, vacío o error y los reportes van en la misma lista para que se desplacen juntos.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/recargar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- El relleno de abajo deja ver el último reporte por encima del botón flotante -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="96dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/boton_nuevo_reporte"
        style="@style/Widget.EcoComunidad.BotonFlotante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/nuevo_reporte"
        app:icon="@drawable/ic_mas" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
