<?xml version="1.0" encoding="utf-8"?>
<!-- "Eco" + "Comunidad" con sus pesos y colores; se lee como un solo nombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nombre_marca"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/app_name"
    android:focusable="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/marca_eco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/marca_eco"
        android:textAppearance="@style/TextAppearance.EcoComunidad.MarcaEco" />

    <TextView
        android:id="@+id/marca_comunidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/marca_comunidad"
        android:textAppearance="@style/TextAppearance.EcoComunidad.MarcaComunidad" />
</LinearLayout>
