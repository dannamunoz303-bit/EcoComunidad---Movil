<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="32dp">

        <co.ecocomunidad.app.ui.componentes.LogoAnimadoView
            android:id="@+id/logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/nombre"
            layout="@layout/vista_nombre_marca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo" />

        <LinearLayout
            android:id="@+id/formulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nombre"
            app:layout_constraintWidth_max="480dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EcoComunidad.TarjetaClara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/login_titulo"
                        style="@style/Widget.EcoComunidad.TextoTitulo"
                        android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta" />

                    <include
                        android:id="@+id/aviso_exito"
                        layout="@layout/vista_aviso_exito" />

                    <include
                        android:id="@+id/aviso"
                        layout="@layout/vista_aviso" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campo_correo"
                        style="@style/Widget.EcoComunidad.Campo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/campo_correo">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/texto_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campo_contrasena"
                        style="@style/Widget.EcoComunidad.Campo.Contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/campo_contrasena">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/texto_contrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_entrar"
                            style="@style/Widget.EcoComunidad.BotonPrincipal"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/boton_entrar" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cargando"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/tinta_suave"
                            app:indicatorSize="18dp"
                            app:trackThickness="2dp" />
                    </FrameLayout>

                    <!-- Carga de más de 1 s: Brotico piensa (marca.md) -->
                    <LinearLayout
                        android:id="@+id/carga_larga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/brotico_piensa" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_revisando"
                            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                            android:textColor="@color/tinta_suave"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sin_cuenta"
                    android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                    android:textColor="@color/tinta_suave"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_registrate"
                    style="@style/Widget.EcoComunidad.BotonTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_registrate" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
