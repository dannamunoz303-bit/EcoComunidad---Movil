<?xml version="1.0" encoding="utf-8"?>
<!--
  Todos los reportes del gestor (RN-10): las mismas tarjetas de la pestaña Todos del ciudadano,
  sin pestañas ni botón de crear. Los estados de carga, vacío o error van en la lista.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra: volver y título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_volver"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/volver"
                app:icon="@drawable/ic_volver"
                app:iconTint="@color/verde_bosque" />

            <TextView
                style="@style/Widget.EcoComunidad.TextoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:accessibilityHeading="true"
                android:text="@string/todos_los_reportes"
                android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/todos_reportes_explicacion"
            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
            android:textColor="@color/tinta_suave"
            android:textSize="14sp"
            app:lineHeight="20sp" />

        <!-- Se buscan sus tareas para saber si abrir la tarea o el reporte -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progreso_abrir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cargando"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/verde_bosque" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/recargar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
