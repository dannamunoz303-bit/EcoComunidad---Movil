<?xml version="1.0" encoding="utf-8"?>
<!-- Elegir el municipio del reporte (RN-23): buscador y la lista de los 42, ordenada por nombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_buscar"
        style="@style/Widget.EcoComunidad.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/municipio_buscar"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/texto_buscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/sin_resultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:text="@string/municipio_sin_resultados"
        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
        android:textColor="@color/tinta_suave"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp"
        android:divider="@null" />
</LinearLayout>
