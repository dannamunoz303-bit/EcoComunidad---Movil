<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de Mis tareas del gestor: la misma barra del ciudadano, saludo de Brotico con las tareas activas y pestañas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- El nombre conserva su ancho completo; el espacio flexible empuja los botones -->
        <include
            layout="@layout/vista_logo_con_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Campana: punto rojo si hay notificaciones sin leer -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_notificaciones"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/notificaciones"
                android:tooltipText="@string/notificaciones"
                app:icon="@drawable/ic_campana"
                app:iconTint="@color/verde_bosque" />

            <View
                android:id="@+id/punto_campana"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="11dp"
                android:background="@drawable/punto_campana"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Menú: por ahora solo Cerrar sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_mi_cuenta"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/menu"
            android:tooltipText="@string/menu"
            app:icon="@drawable/ic_menu"
            app:iconTint="@color/verde_bosque" />
    </LinearLayout>

    <!-- Tarjeta destacada en verde bosque (marca.md) -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.EcoComunidad.TarjetaDestacada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/brotico_saludando"
                android:src="@drawable/brotico_saluda" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/saludo"
                    style="@style/Widget.EcoComunidad.TextoTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saludo_sin_nombre"
                    android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta"
                    android:textColor="@color/superficie" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:id="@+id/resumen"
                    android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                    android:textColor="@color/verde_brote"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filtros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        app:checkedChip="@id/filtro_activas"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/filtro_activas"
            style="@style/Widget.EcoComunidad.ChipFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtro_activas" />

        <com.google.android.material.chip.Chip
            android:id="@+id/filtro_terminadas"
            style="@style/Widget.EcoComunidad.ChipFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filtro_terminadas" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
