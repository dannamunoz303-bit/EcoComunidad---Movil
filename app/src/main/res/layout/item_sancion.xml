<?xml version="1.0" encoding="utf-8"?>
<!-- Una sanción: tipo como etiqueta, fecha de inicio, motivo y el reporte si se conoce. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.EcoComunidad.TarjetaReporte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tipo"
                style="@style/Widget.EcoComunidad.EtiquetaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/fecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                android:textColor="@color/tinta_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/motivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
            android:textSize="15sp"
            app:lineHeight="21sp" />

        <TextView
            android:id="@+id/reporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
            android:textColor="@color/tinta_suave"
            android:textSize="13sp" />

        <!-- Bloqueo temporal: hasta cuándo; bloqueo levantado: desde cuándo -->
        <TextView
            android:id="@+id/fin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
            android:textColor="@color/tinta_suave"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
