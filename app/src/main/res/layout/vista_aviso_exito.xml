<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de que algo salió bien (por ejemplo, la cuenta quedó creada). Oculto hasta que haga falta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aviso_exito"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/fondo_aviso_exito"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_listo"
        app:tint="@color/verde_bosque" />

    <TextView
        android:id="@+id/aviso_exito_texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
        android:textSize="14sp"
        app:lineHeight="20sp" />
</LinearLayout>
