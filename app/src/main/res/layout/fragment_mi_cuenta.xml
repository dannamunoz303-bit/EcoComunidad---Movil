<?xml version="1.0" encoding="utf-8"?>
<!-- Mi cuenta del ciudadano: datos de auth/yo/ y las opciones de la cuenta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra: volver y título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/volver"
            app:icon="@drawable/ic_volver"
            app:iconTint="@color/verde_bosque" />

        <TextView
            style="@style/Widget.EcoComunidad.TextoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:accessibilityHeading="true"
            android:text="@string/mi_cuenta"
            android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="560dp">

                <!-- Quién tiene la sesión: tarjeta destacada en verde bosque (marca.md) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EcoComunidad.TarjetaDestacada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <!-- Iniciales en un círculo verde (sobre el verde bosque va el verde brote) -->
                        <TextView
                            android:id="@+id/iniciales"
                            style="@style/Widget.EcoComunidad.TextoTitulo"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/fondo_circulo"
                            android:backgroundTint="@color/verde_brote"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta"
                            android:textColor="@color/verde_bosque" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nombre"
                                style="@style/Widget.EcoComunidad.TextoTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.TituloTarjeta"
                                android:textColor="@color/superficie" />

                            <TextView
                                android:id="@+id/correo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Cuerpo"
                                android:textColor="@color/verde_brote"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/rol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/fondo_pildora_rol"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textAppearance="@style/TextAppearance.EcoComunidad.Etiqueta"
                                android:textColor="@color/verde_bosque"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Opciones -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EcoComunidad.TarjetaClara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/opcion_novedades"
                            style="@style/Widget.EcoComunidad.OpcionMenu"
                            android:text="@string/mis_novedades"
                            app:drawableStartCompat="@drawable/ic_mensaje" />

                        <TextView
                            android:id="@+id/opcion_sanciones"
                            style="@style/Widget.EcoComunidad.OpcionMenu"
                            android:text="@string/mis_sanciones"
                            app:drawableStartCompat="@drawable/ic_escudo" />

                        <TextView
                            android:id="@+id/opcion_contrasena"
                            style="@style/Widget.EcoComunidad.OpcionMenu"
                            android:text="@string/cambiar_contrasena"
                            app:drawableStartCompat="@drawable/ic_candado" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginVertical="4dp"
                            android:background="@color/borde" />

                        <TextView
                            android:id="@+id/opcion_cerrar_sesion"
                            style="@style/Widget.EcoComunidad.OpcionMenu.Peligro"
                            android:text="@string/cerrar_sesion"
                            app:drawableStartCompat="@drawable/ic_salir" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
