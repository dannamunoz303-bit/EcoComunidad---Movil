<?xml version="1.0" encoding="utf-8"?>
<!-- Tipografía y componentes de marca (marca.md): títulos en Bricolage Grotesque, texto en Instrument Sans. -->
<resources>

    <!-- Títulos y números grandes: Bricolage Grotesque 700 -->
    <!-- El tamaño baja en pantallas estrechas (values/dimens.xml y values-w400dp/dimens.xml) -->
    <style name="TextAppearance.EcoComunidad.Titulo" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <!-- Títulos de sección y de tarjeta: Bricolage Grotesque 500 -->
    <style name="TextAppearance.EcoComunidad.Subtitulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/bricolage_grotesque_medium</item>
        <item name="android:fontFamily">@font/bricolage_grotesque_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <!-- Texto corrido y formularios: Instrument Sans 400 -->
    <style name="TextAppearance.EcoComunidad.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/instrument_sans</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <!-- Botones, etiquetas y chips: Instrument Sans 600 -->
    <style name="TextAppearance.EcoComunidad.Etiqueta" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <!-- Título de cada tarjeta ("Inicia sesión", "Crea tu cuenta"…) -->
    <style name="TextAppearance.EcoComunidad.TituloTarjeta" parent="TextAppearance.EcoComunidad.Subtitulo">
        <item name="android:textSize">@dimen/texto_titulo_tarjeta</item>
        <item name="android:textColor">@color/verde_bosque</item>
    </style>

    <!-- Nombre de marca: "Eco" verde musgo 500 y "Comunidad" verde bosque 700 -->
    <style name="TextAppearance.EcoComunidad.MarcaEco" parent="TextAppearance.EcoComunidad.Titulo">
        <item name="fontFamily">@font/bricolage_grotesque_medium</item>
        <item name="android:fontFamily">@font/bricolage_grotesque_medium</item>
        <item name="android:textSize">@dimen/texto_marca</item>
        <item name="android:textColor">@color/verde_musgo</item>
    </style>

    <style name="TextAppearance.EcoComunidad.MarcaComunidad" parent="TextAppearance.EcoComunidad.Titulo">
        <item name="android:textSize">@dimen/texto_marca</item>
        <item name="android:textColor">@color/verde_bosque</item>
    </style>

    <!--
      Títulos: nunca se parten palabras con guion. El ancho de cada título cabe desde 320 dp
      gracias a los tamaños de dimens.xml.
    -->
    <style name="Widget.EcoComunidad.TextoTitulo" parent="">
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:breakStrategy">simple</item>
    </style>

    <!-- Cada parte del nombre de marca va en una sola línea y nunca se aprieta -->
    <style name="Widget.EcoComunidad.TextoMarca" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>

    <!-- Tarjeta clara: blanca, esquinas de 24 dp, borde de marca, sin sombra -->
    <style name="Widget.EcoComunidad.TarjetaClara" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tarjeta destacada en verde bosque (marca.md: no todas las tarjetas iguales) -->
    <style name="Widget.EcoComunidad.TarjetaDestacada" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/verde_bosque</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Campo con contorno: esquinas de 16 dp, fondo blanco, arcilla con error -->
    <style name="Widget.EcoComunidad.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/borde_campo</item>
        <item name="boxStrokeErrorColor">@color/arcilla</item>
        <item name="hintTextColor">@color/verde_bosque</item>
        <item name="errorTextColor">@color/arcilla</item>
        <item name="errorIconDrawable">@null</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- Campo de contraseña: con el ojo de Lucide para mostrarla u ocultarla -->
    <style name="Widget.EcoComunidad.Campo.Contrasena">
        <item name="endIconMode">password_toggle</item>
        <item name="endIconDrawable">@drawable/ic_ojo_alternar</item>
        <item name="endIconTint">@color/tinta_suave</item>
        <item name="endIconContentDescription">@string/mostrar_contrasena</item>
    </style>

    <!-- Desplegable con el mismo aspecto que los campos (categoría del reporte) -->
    <style name="Widget.EcoComunidad.Campo.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/borde_campo</item>
        <item name="boxStrokeErrorColor">@color/arcilla</item>
        <item name="hintTextColor">@color/verde_bosque</item>
        <item name="errorTextColor">@color/arcilla</item>
        <item name="errorIconDrawable">@null</item>
        <item name="endIconTint">@color/tinta_suave</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- Botón flotante "Nuevo reporte": píldora verde bosque con sombra leve -->
    <style name="Widget.EcoComunidad.BotonFlotante" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/verde_bosque</item>
        <item name="android:textColor">@color/superficie</item>
        <item name="iconTint">@color/superficie</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="shapeAppearanceOverlay">@style/Forma.EcoComunidad.Pildora</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Forma.EcoComunidad.Pildora" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Botón principal: píldora verde bosque, alto 52 dp -->
    <style name="Widget.EcoComunidad.BotonPrincipal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fondo_boton_principal</item>
        <item name="android:textColor">@color/texto_boton_principal</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tarjeta de cada reporte en la lista: clara, esquinas de 20 dp -->
    <style name="Widget.EcoComunidad.TarjetaReporte" parent="Widget.EcoComunidad.TarjetaClara">
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- Marco de las fotos: recorta la imagen con esquinas redondeadas -->
    <style name="Widget.EcoComunidad.MarcoFoto" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/fondo</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chip de filtro de la lista ("Todos", "Mis reportes") -->
    <style name="Widget.EcoComunidad.ChipFiltro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/fondo_chip</item>
        <item name="chipStrokeColor">@color/borde_chip</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/texto_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
    </style>

    <!-- Botón secundario: píldora con borde verde bosque (Reintentar) -->
    <style name="Widget.EcoComunidad.BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="strokeColor">@color/verde_bosque</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Botón para acciones que no se deshacen (Eliminar): borde y texto arcilla -->
    <style name="Widget.EcoComunidad.BotonPeligro" parent="Widget.EcoComunidad.BotonSecundario">
        <item name="android:textColor">@color/arcilla</item>
        <item name="strokeColor">@color/arcilla</item>
        <item name="iconTint">@color/arcilla</item>
    </style>

    <!-- Etiqueta de estado del reporte: punto de color y texto en tinta (contraste 4,5:1) -->
    <style name="Widget.EcoComunidad.EtiquetaEstado" parent="">
        <item name="android:background">@drawable/fondo_estado</item>
        <item name="android:drawableStart">@drawable/punto_estado</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Botón de texto en verde bosque -->
    <style name="Widget.EcoComunidad.BotonTexto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoComunidad.Etiqueta</item>
        <item name="iconTint">@color/verde_bosque</item>
    </style>
</resources>
